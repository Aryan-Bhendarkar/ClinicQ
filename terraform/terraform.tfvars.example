# Copy to terraform.tfvars (git-ignored) and adjust. No credentials belong here:
# authenticate with `aws configure` / `aws login` / environment variables instead.
aws_region          = "ap-south-1"
environment         = "dev"
cluster_name        = "clinicq-eks"
kubernetes_version  = "1.31"
node_instance_types = ["t3.medium"]
node_min_size       = 2
node_desired_size   = 3
node_max_size       = 4
